# Public address of this website (used for canonical links, the sitemap and social previews).
NEXT_PUBLIC_SITE_URL=https://engage-site.10xdigital.ae

# The product. Every "Sign in" / "Start free trial" link on the site points here.
NEXT_PUBLIC_APP_URL=https://app.10xdigital.ae

# The product's API, called from this site's SERVER only (pricing, demo form).
# Inside the same Docker network this can be the internal address, e.g. http://app:8000/api/v1
ENGAGE_API_URL=https://app.10xdigital.ae/api/v1

# Optional: WhatsApp number for the "Chat on WhatsApp" buttons, digits only with country code.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional: public contact email shown on the Contact page and in the footer.
NEXT_PUBLIC_CONTACT_EMAIL=
